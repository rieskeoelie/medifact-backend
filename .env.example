# BCK Research Intelligence API — Environment Variables

# REQUIRED: Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL: Model to use (default: claude-haiku-4-5-20251001 — fast & cheap)
# Use claude-sonnet-4-6 for more precise consensus analysis (A3, A4, A5, A7)
BCK_MODEL=claude-haiku-4-5-20251001

# OPTIONAL: Port (default: 8000)
PORT=8000

# OPTIONAL: Off-site database backup to Cloudflare R2 (used by POST /cron/backup-db).
# If unset, the backup endpoint returns 200 with {"skipped": "R2 not configured"}.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=medifact-db-backups
# Days to keep dumps before auto-pruning (default 30)
BACKUP_RETENTION_DAYS=30
